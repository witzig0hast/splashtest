{
  "name": "splash-party",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build:shared": "npm run build -w packages/shared",
    "build:server": "npm run typecheck -w apps/server",
    "build:web": "npm run build -w apps/web",
    "build": "npm run build:shared && npm run build:server && npm run build:web",
    "start": "npm run start -w apps/server"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
